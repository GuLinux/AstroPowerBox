#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

usage() {
    cat >&2 <<EOF
Usage: $(basename "$0") [--skip-upload]

Runs backend MicroPython tests on a connected device.
By default it uploads backend/tests_mpy first.
The device is reset after tests so the application starts normally again.
EOF
    exit "${1:-0}"
}

skip_upload=false
while [[ $# -gt 0 ]]; do
    case "$1" in
        --skip-upload)
            skip_upload=true
            ;;
        -h|--help)
            usage 0
            ;;
        *)
            echo "Unknown argument: $1" >&2
            usage 1
            ;;
    esac
    shift
done

if ! command -v mpremote >/dev/null 2>&1; then
    echo "Error: mpremote is required" >&2
    exit 1
fi

devices="$(mpremote devs 2>/dev/null)"
if [[ -z "$devices" ]]; then
    echo "Error: no MicroPython device found (mpremote devs returned nothing)" >&2
    exit 1
fi

cd "$ROOT_DIR"

if [[ "$skip_upload" == false ]]; then
    mpremote fs mkdir :/tests_mpy >/dev/null 2>&1 || true

    # Upload backend modules used by tests_mpy so imports resolve on device.
    for module in backend/wifi.py backend/utils.py; do
        echo "Uploading $module"
        mpremote fs cp "$module" ":/$(basename "$module")"
    done

    while IFS= read -r test_file; do
        echo "Uploading $test_file"
        mpremote fs cp "$test_file" ":/${test_file#backend/}"
    done < <(find backend/tests_mpy -type f -name '*.py' | sort)
fi

test_status=0
mpremote exec "import tests_mpy.run_tests as rt; failures = rt.main(); assert failures == 0, '{} MicroPython test(s) failed'.format(failures)" || test_status=$?

echo "Restarting MCU after tests"
reset_status=0
mpremote reset || reset_status=$?

if [[ "$test_status" -ne 0 ]]; then
    exit "$test_status"
fi

if [[ "$reset_status" -ne 0 ]]; then
    echo "Error: failed to restart MCU after tests" >&2
    exit "$reset_status"
fi
