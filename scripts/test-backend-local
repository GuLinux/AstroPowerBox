#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

cd "$ROOT_DIR"

if ! command -v pytest >/dev/null 2>&1; then
    echo "Error: pytest is not installed. Install with: pip install pytest" >&2
    exit 1
fi

exec pytest -q backend/tests "$@"
