{
    "hardware": "cpython",
    "board": "generic",
    "hardware_name": "Linux SBC",
    "comment": "Default AstroPowerBox application pinout for Linux SBCs",
    "status_led": {
        "type": "pwm",
        "pin": "LED_STATUS"
    },
    "fan": {
        "type": "pwm",
        "pin": "FAN"
    },
    "heaters": [
        {
            "type": "pwm",
            "pin": "PWM1",
            "temp": {
                "type": "thermistor",
                "pin": "ANALOG_IN0",
                "beta": 3950,
                "r0": 10000,
                "t0_c": 25,
                "series_resistor": 10000,
                "vcc": 3.3,
                "wiring": "ntc_to_vcc"
            }
        },
        {
            "type": "pwm",
            "pin": "PWM2",
            "temp": {
                "type": "thermistor",
                "pin": "ANALOG_IN1",
                "beta": 3950,
                "r0": 10000,
                "t0_c": 25,
                "series_resistor": 10000,
                "vcc": 3.3,
                "wiring": "ntc_to_vcc"
            }
        }
    ],
    "outputs": [
        {
            "type": "pwm",
            "pin": "PWM3"
        },
        {
            "type": "pwm",
            "pin": "PWM4"
        },
        {
            "type": "pwm",
            "pin": "PWM5"
        },
        {
            "type": "pwm",
            "pin": "PWM6"
        }
    ],
    "buttons": [
        "BTN0",
        "BTN1"
    ]
}
